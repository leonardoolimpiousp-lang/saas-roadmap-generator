{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadmap-kit.local/schemas/risk.schema.json",
  "title": "Roadmap Risk",
  "type": "object",
  "required": ["id", "title", "probability", "impact", "owner", "mitigation"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "probability": { "enum": ["low", "medium", "high"] },
    "impact": { "enum": ["low", "medium", "high", "critical"] },
    "owner": { "type": "string" },
    "mitigation": { "type": "string" }
  }
}

