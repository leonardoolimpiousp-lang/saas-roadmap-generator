{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadmap-kit.local/schemas/roadmap-task.schema.json",
  "title": "RoadmapTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "catalogKey", "origin", "module", "phase", "track", "epic", "title", "description", "rationale", "priority", "effort", "ownerRole", "dependencies", "acceptanceCriteria", "riskIds", "applicability", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3,}$" },
    "catalogKey": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "origin": { "enum": ["core", "conditional", "domain-specific"] },
    "module": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "pattern": "^F[0-9]+$" },
    "track": { "type": "string", "minLength": 1 },
    "epic": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "rationale": { "type": "string", "minLength": 10 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "effort": { "enum": ["XS", "S", "M", "L", "XL"] },
    "ownerRole": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 5 } },
    "riskIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "milestone": { "type": "string" },
    "releaseGate": { "type": "string" },
    "applicability": { "enum": ["included", "not_applicable", "uncertain"] },
    "exclusionReason": { "type": "string" },
    "status": { "enum": ["backlog", "ready", "doing", "review", "done", "blocked", "not_applicable"] },
    "critical": { "type": "boolean" },
    "criticalPathOrder": { "type": "integer", "minimum": 0 }
  }
}

